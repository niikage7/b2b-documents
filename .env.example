# Скопируйте в .env и заполните. Секреты (ключи, пароли) — только в .env.

# --- ML: LLM (OpenRouter или любой API, совместимый с OpenAI; для vLLM — его адрес) ---
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
# Идентификатор модели у провайдера, например из каталога OpenRouter; выбор — в docs/ml-plan.md
LLM_MODEL=deepseek/deepseek-v4.1-flash-1017
# Модель для короткого вызова «предмет закупки»; пусто — та же, что LLM_MODEL
LLM_META_MODEL=
LLM_TIMEOUT=90
LLM_MAX_RETRIES=3
# Не больше стольких одновременных вызовов LLM на процесс воркера
LLM_MAX_CONCURRENCY=8
# json_schema → json_object → none: формат ответа понижается сам, если модель его не принимает
LLM_RESPONSE_FORMAT=json_schema
# Рассуждения модели (только OpenRouter): default — как у модели, none — выключить,
# minimal, low, medium, high, xhigh, max — уровень. Рассуждения входят в max_tokens и в стоимость;
# сравнить режимы: python -m bench.pipeline --pages 20 --reasoning default,low,none --repeat 3.
# Если включаете low и выше — увеличьте LLM_MAX_TOKENS (по умолчанию 8000): иначе ответы обрезаются
LLM_REASONING=none
LLM_CACHE=1

# --- ML: эмбеддинги; размерность должна совпадать с vector(N) в схеме chunk ---
EMBEDDING_MODEL=sergeyzh/BERTA
EMBEDDING_DIM=768
EMBEDDING_DEVICE=cpu

# --- ML: движок правил ---
RULES_PER_GROUP=4
# Поиск фрагментов для semantic_llm: фрагмент около CHUNK_TOKENS токенов (примерно пункт договора),
# режим hybrid (векторы + BM25), dense или lexical; каждому правилу — до SEARCH_BUDGET_TOKENS текста.
# Размер фрагмента меняет таблицу chunk: после правки документы нужно проиндексировать заново
CHUNK_TOKENS=60
CHUNK_OVERLAP=0
SEARCH_MODE=hybrid
SEARCH_BUDGET_TOKENS=3200
LLM_WINDOW_TOKENS=6000
QUOTE_MIN_SCORE=90
TEST_RULE_TIMEOUT=60

# --- ML: извлечение текста и OCR ---
ML_MAX_PAGES=500
ML_CACHE_DIR=/var/cache/b2b-ml
OCR_LANG=rus+eng
OCR_DPI=300
OCR_LOW_QUALITY_THRESHOLD=0.75

# --- Слой данных ---
# Строка подключения SQLAlchemy (драйвер psycopg 3); в docker-compose — адрес сервиса БД
DATABASE_URL=postgresql+psycopg://b2b:b2b@localhost:5432/b2b
# Пароль трёх демо-пользователей (specialist, lawyer, methodologist), которых создаёт python -m db.seed;
# в docker-compose без этой переменной пароль — demo
DEMO_PASSWORD=

# --- API и окружение docker-compose ---
# Без .env docker-compose подставит значения для разработки; в рабочем окружении задайте свои
POSTGRES_USER=b2b
POSTGRES_PASSWORD=b2b
POSTGRES_DB=b2b
# Секрет подписи сессий (JWT): длинная случайная строка, не короче 16 символов; без неё API не стартует
JWT_SECRET=
# Срок жизни сессии в часах
SESSION_TTL_HOURS=12
# true — только при доступе по https: иначе браузер не сохранит cookie сессии
COOKIE_SECURE=false
# Порт API на хосте (127.0.0.1); интерфейс в режиме npm run dev проксирует /api на http://localhost:8000
API_PORT=8000
REDIS_URL=redis://localhost:6379/0
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=b2b-minio
MINIO_SECRET_KEY=b2b-minio-secret
MINIO_BUCKET=b2b-documents
MINIO_SECURE=false
MINIO_CONSOLE_PORT=9001


# --- Воркеры Celery (очереди ingest, ocr, analysis, export; брокер — REDIS_URL) ---
# Процессов пула в сервисе worker (ingest, analysis, export) и в сервисе worker-ocr; каждая задача OCR
# распознаёт страницы ещё в пуле до 4 потоков
WORKER_CONCURRENCY=2
OCR_WORKER_CONCURRENCY=2
# Страниц скана в одной задаче OCR: группы распознаются параллельно
OCR_PAGES_PER_TASK=5
# Распаковка zip: лимит объёма после распаковки (МБ) и числа файлов на пакет, глубина вложенных архивов
UNPACK_MAX_MB=500
UNPACK_MAX_FILES=500
UNPACK_MAX_DEPTH=3
# Повторы временных ошибок этапа (сбой связи, LLM недоступна): всего попыток и база паузы в секундах
# (5, 10, 20 …); после последней неудачи — «Ошибка» у документа и запись в Redis-список b2b:dead-letter
TASK_MAX_ATTEMPTS=3
TASK_RETRY_BASE_SECONDS=5
# Остановка воркера: столько секунд задачи доделываются, остальные возвращаются в очередь
WORKER_SOFT_SHUTDOWN_SECONDS=20
# Воркер убит без остановки: через столько секунд Redis вернёт его задачи в очередь
CELERY_VISIBILITY_TIMEOUT=3600
# SSE прогресса пакета: heartbeat в секундах и время жизни соединения (браузер переподключается сам)
SSE_HEARTBEAT_SECONDS=15
SSE_MAX_SECONDS=3000
# Выгрузка: часовой пояс дат на листе «Итоги» в Сводка.xlsx; файлы выгрузки хранятся сутки
EXPORT_TIMEZONE=Europe/Moscow

# --- Заглушка LLM (docker-compose, сервис llm-stub) ---
# Без LLM_BASE_URL и LLM_MODEL в .env воркеры docker-compose ходят в заглушку: находки строятся без модели
# и ничего не стоят. Строки LLM_BASE_URL и LLM_MODEL из раздела «ML: LLM» выше включают настоящую модель —
# чтобы остаться на заглушке, не переносите их в .env. Задержка ответа заглушки в секундах (для замеров):
LLM_STUB_DELAY=0
